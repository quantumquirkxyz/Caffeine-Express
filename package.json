{
  "name": "fieldsight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP installed-base intelligence prototype: validated Observation persistence data plane.",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:no-cloud": "node scripts/check-no-cloud-inference.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@qvac/sdk": "^0.19.0",
    "expo": "^57.0.21",
    "expo-build-properties": "~57.0.17",
    "expo-device": "^57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bare-kit": "^0.11.5",
    "react-native-web": "^0.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
